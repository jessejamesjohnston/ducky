<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- USE_EXACT_ALARM: the exact-alarm permission for timer and alarm-clock apps. Unlike
         SCHEDULE_EXACT_ALARM the user can't revoke it, so a set timer always rings. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16+ Live Updates (promoted ongoing countdown). Normal perm. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Ducky never goes online, so no network permission may reach the APK. WorkManager (pulled in
         by Glance for widget updates) declares ACCESS_NETWORK_STATE for work with a network
         constraint; Ducky schedules none, so the merge drops it. The build fails if any network
         permission appears in a merged manifest (checkDebugManifestPermissions and
         checkReleaseManifestPermissions, in app/build.gradle.kts). -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <application
        android:name=".TimerApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.Timer">

        <!-- The launcher entry is one of 12 color-matched activity-aliases
             below (swapped at runtime so the app icon, and the icon circle
             Android 17 derives from it on notifications, follows the user's
             accent color). MainActivity itself has no LAUNCHER filter. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" />

        <activity-alias
            android:name=".LauncherRed"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_red"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherOrange"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_orange"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherAmber"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_amber"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherOlive"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_olive"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherGreen"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_green"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherTeal"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_teal"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherCyan"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_cyan"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_blue"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherIndigo"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_indigo"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPurple"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_purple"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherPink"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_pink"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBrown"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher_brown"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="" />

        <receiver
            android:name=".TimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- An app update kills the process: a ringing alarm's service dies with it
                     (alarms and the countdown card survive). Re-derive like a boot. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Wall clock stepped: re-derive alarm/tick/widget from the
                     persisted deadline. Exempt from implicit-broadcast limits. -->
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <service
            android:name=".AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="systemExempted" />

        <receiver
            android:name=".widget.TimerWidgetReceiver"
            android:label="@string/tank_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/timer_widget_info" />
        </receiver>

        <!-- "Lily pads" widget: the same widget, with the duck hopping lily pads in its time box. -->
        <receiver
            android:name=".widget.PondWidgetReceiver"
            android:label="@string/pond_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/pond_widget_info" />
        </receiver>

        <!-- "Bubbles" widget: the same widget, with a row of bubbles that pop one by one. -->
        <receiver
            android:name=".widget.BubblesWidgetReceiver"
            android:label="@string/bubbles_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bubbles_widget_info" />
        </receiver>

        <!-- "Egg timer" widget: the same widget, with a nest of eggs that hatch one by one. -->
        <receiver
            android:name=".widget.EggTimerWidgetReceiver"
            android:label="@string/eggs_widget_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/eggs_widget_info" />
        </receiver>
    </application>
</manifest>
